# --- SSO login (sso.iitb.ac.in) ---
SSO_LOGIN_URL=https://sso.iitb.ac.in/login
SSO_USERNAME=your_ldap_username
SSO_PASSWORD=your_password
# Base32 seed from authenticator setup, NOT the 6-digit code
SSO_TOTP_SECRET=BASE32SECRETHERE

# --- Blog watcher (watcher.py) ---
# Internship blog base URL; its RSS feed is read after SSO login
BLOG_URL=https://example.iitb.ac.in/internship-blog

# --- Job API watcher (jobs_watcher.py) ---
# Placement portal jobs endpoint (the one the /applicant/jobs page calls)
JOBS_API_URL=https://campus.placements.iitb.ac.in/api/v1/...
# Only alert on jobs you are eligible for (default: true)
ONLY_ALERT_ELIGIBLE=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Your own (admin) chat id: receives ops alerts and can use /list
TELEGRAM_CHAT_ID=your_chat_id
